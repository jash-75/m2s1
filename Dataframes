    h += '<a href="#'+s.id+'" data-id="'+s.id+'">'+(s.id==="inicio"?"Inicio":esc(s.getAttribute("data-title")))+'</a>';
  });
  nav.innerHTML = h;
}
function updateNav(){
  var cur = current(), idx = ids().indexOf(cur);
  document.querySelectorAll("nav#nav a").forEach(function(a){
    a.classList.toggle("on", a.getAttribute("data-id") === cur);
    a.classList.toggle("done", !!DONE[a.getAttribute("data-id")]);
  });
  var total = SECS.length - 1, n = Object.keys(DONE).filter(function(k){ return DONE[k]; }).length;
  var pct = Math.round(100 * n / total);
  $("pct").textContent = n + " de " + total + " secciones · " + pct + " %";
  $("bar").style.width = pct + "%";
  var on = document.querySelector("nav#nav a.on");
  if(on && on.scrollIntoView){ on.scrollIntoView({block:"nearest", inline:"center"}); }
}
function show(){
  var cur = current();
  SECS.forEach(function(s){ s.classList.toggle("on", s.id === cur); });
  updateNav();
