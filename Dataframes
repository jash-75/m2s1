var S6_DEFAULT = "nombre: Ana, Bruno, Carla\nnota: 8, 6, 9";
function parseTabla(txt){
  var lines = txt.split("\n").map(function(l){ return l.trim(); }).filter(function(l){ return l.length; });
  var cols = [], vals = [];
  for(var i=0;i<lines.length;i++){
    var k = lines[i].indexOf(":");
    if(k < 0) throw new Error("La línea «"+lines[i]+"» necesita dos puntos: nombre de columna: valores.");
    var name = lines[i].slice(0,k).trim();
    if(!name) throw new Error("Falta el nombre de la columna en «"+lines[i]+"».");
    var items = lines[i].slice(k+1).split(",").map(function(x){ return x.trim(); }).filter(function(x){ return x.length; });
    cols.push(name); vals.push(items);
  }
  if(!cols.length) throw new Error("Escribe al menos una columna.");
  var n = vals[0].length;
  for(var j=0;j<vals.length;j++){
    if(vals[j].length !== n) throw new Error("La columna «"+cols[j]+"» tiene "+vals[j].length+" valor(es) y la primera tiene "+n+". Todas las columnas deben tener la misma cantidad de valores, porque cada posición es una fila.");
  }
  var rows = [];
  for(var r=0;r<n;r++){ var fila = []; for(var c=0;c<cols.length;c++){ fila.push(vals[c][r]); } rows.push(fila); }
  return {cols:cols, rows:rows};
}
