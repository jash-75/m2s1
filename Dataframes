/* ---------- MODO ENFOQUE ---------- */
var focusLeft = 25*60, focusTimer = null;
function paintFocus(){
  var m = Math.floor(focusLeft/60), s = focusLeft % 60;
  $("focusTime").textContent = (m<10?"0":"")+m+":"+(s<10?"0":"")+s;
}
$("focusBtn").onclick = function(){
  if(focusTimer){ clearInterval(focusTimer); focusTimer = null; this.textContent = "Continuar"; return; }
  this.textContent = "Pausar";
  focusTimer = setInterval(function(){
    focusLeft--; paintFocus();
    if(focusLeft <= 0){ clearInterval(focusTimer); focusTimer = null; focusLeft = 5*60; paintFocus(); $("focusBtn").textContent = "Pausa de 5 min"; }
  }, 1000);
};
$("focusReset").onclick = function(){ clearInterval(focusTimer); focusTimer = null; focusLeft = 25*60; paintFocus(); $("focusBtn").textContent = "Iniciar 25 min"; };
