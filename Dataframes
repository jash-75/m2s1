function limpiar(t){ return t.toLowerCase().replace(/[^\w\sáéíóúñü]/g,"").trim(); }
function clasificar(t){
  var l = limpiar(t);
  for(var i=0;i<POS.length;i++){ if(l.indexOf(POS[i]) >= 0) return {res:"Positivo", por:POS[i]}; }
  for(var j=0;j<NEG.length;j++){ if(l.indexOf(NEG[j]) >= 0) return {res:"Negativo", por:NEG[j]}; }
  return {res:"Neutro", por:null};
}
